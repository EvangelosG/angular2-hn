{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "types": ["vite/client"]
    },
    "include": [
        "src/main.tsx",
        "src/App.tsx",
        "src/vite-env.d.ts",
        "src/api",
        "src/models",
        "src/components",
        "src/context",
        "src/pages",
        "src/hooks",
        "src/utils",
        "src/test"
    ],
    "references": [{ "path": "./tsconfig.node.json" }]
}
